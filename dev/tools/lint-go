# Run golangci-lint with the project's pinned config.
#
# Pass --fix to apply auto-fixable suggestions in place.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

# Pin the exact version that the project targets. GitHub Actions runners
# pre-install a system golangci-lint on PATH that may differ in version or
# Go build toolchain, so verify the version explicitly rather than accepting
# whatever `command -v golangci-lint` finds first.
GOLANGCI_LINT_VERSION="v2.12.1"
WANT_VER="${GOLANGCI_LINT_VERSION#v}"
GOBIN_DIR="${GOBIN:-$(go env GOPATH)/bin}"

LINT_BIN=""
if [[ -x "$GOBIN_DIR/golangci-lint" ]] && "$GOBIN_DIR/golangci-lint" --version 2>/dev/null | grep -qF "version ${WANT_VER} "; then
  LINT_BIN="$GOBIN_DIR/golangci-lint"
elif command -v golangci-lint >/dev/null 2>&1 && golangci-lint --version 2>/dev/null | grep -qF "version ${WANT_VER} "; then
  LINT_BIN="$(command -v golangci-lint)"
else
  echo "▸ installing golangci-lint ${GOLANGCI_LINT_VERSION} into ${GOBIN_DIR}" >&2
  GOBIN="$GOBIN_DIR" go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}"
  LINT_BIN="$GOBIN_DIR/golangci-lint"
fi

exec "$LINT_BIN" run \
  --config=dev/tools/.golangci.yml \
  "$@"
